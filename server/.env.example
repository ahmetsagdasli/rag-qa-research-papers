# OpenAI API key (required for embeddings + LLM)
OPENAI_API_KEY=your_openai_api_key_here
# Optional PostgreSQL + pgvector primary vector store. Leave unset to retain local JSON fallback.
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
# Optional Redis/BullMQ job queue. Docker Compose configures this automatically.
REDIS_URL=redis://localhost:6379
# Integration-test overrides; point these to local mock HTTP services, never production keys.
TEST_DATABASE_URL=postgres://rag:rag@localhost:5433/rag_test
TEST_REDIS_URL=redis://localhost:6380
OPENAI_BASE_URL=
COHERE_BASE_URL=


# Models (override if you like)
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini


# Server
PORT=5050
CORS_ORIGIN=*
# Opsiyonel shared-secret auth. Set edilirse tüm /api istekleri X-API-Key header'ı ile eşleşmeli.
# Boş bırakılırsa (varsayılan) auth devre dışıdır — lokal/tek kullanıcı kullanım için.
API_KEY=
# IP başına dakikalık istek limiti.
RATE_LIMIT_PER_MINUTE=120


# ---- Two-stage retrieval + cross-encoder reranking ----
# Reranking'i aç/kapat (A/B karşılaştırması). false ise eski tek-aşamalı cosine davranışı.
USE_RERANKER=true
# Cohere Rerank API anahtarı. Boşsa reranking otomatik atlanır (graceful fallback).
COHERE_API_KEY=your_cohere_api_key_here
# (opsiyonel) rerank modeli — çok dilli (TR/EN vb.) için multilingual kullanın
RERANK_MODEL=rerank-multilingual-v3.0
# 1. aşama: vektör aramasından getirilecek aday sayısı (top-N)
RETRIEVE_TOP_N=20
# 2. aşama: reranking sonrası LLM'e verilecek nihai sayı (top-K)
FINAL_TOP_K=4
