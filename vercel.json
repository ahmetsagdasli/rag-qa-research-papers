{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/docs/:path*", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  }
}
